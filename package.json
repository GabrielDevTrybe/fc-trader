{
  "name": "fc-trader",
  "version": "0.2.1",
  "description": "Terminal financeiro e analisador de mercado para Ultimate Team no EA SPORTS FC 27.",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/run-pytest.js",
    "test:frontend": "npm run test --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
