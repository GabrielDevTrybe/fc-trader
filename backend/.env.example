# ==============================================================================
# FC TRADER - BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to backend/.env and fill in the values.
# NEVER commit real credentials to version control.

# PostgreSQL / Supabase connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# In Supabase: Project Settings -> Database -> Connection string (URI or Session pooler)
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Application Core Settings
APP_ENV=development
APP_NAME=FC Trader
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (frontend origin)
CORS_ORIGINS=http://localhost:3000

# Trading Engine Rule Configurations
TRADING_TAX_RATE=0.05
INITIAL_BANKROLL=5000
MINIMUM_PROFIT=100
MINIMUM_ROI=0.15
MAX_BANKROLL_PERCENTAGE_PER_TRADE=0.20
MINIMUM_CONFIDENCE=0.60
